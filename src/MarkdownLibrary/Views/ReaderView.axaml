<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarkdownLibrary.Library.ViewModels"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             x:Class="MarkdownLibrary.Views.ReaderView"
             x:DataType="vm:ReaderViewModel">
    <Grid ColumnDefinitions="238,*">
        <Border Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Margin="18,18,18,10" Spacing="4">
                    <TextBlock Text="目录" FontSize="12" Foreground="#9CA3AF" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="#4B5563"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="8,0,8,12"
                         ItemsSource="{Binding Toc}"
                         SelectedItem="{Binding SelectedTocItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Margin="4,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="52,*">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">
                <Button Content="← 返回"
                        Command="{Binding GoBackCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#2563EB"
                        Padding="0"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding BookTitle}"
                           FontSize="14"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="阅读中"
                           FontSize="12"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="30,22">
                <md:MarkdownScrollViewer x:Name="MarkdownView"
                                         Markdown="{Binding MarkdownText}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
