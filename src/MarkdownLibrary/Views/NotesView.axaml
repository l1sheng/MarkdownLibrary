<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarkdownLibrary.Library.ViewModels"
             xmlns:models="using:MarkdownLibrary.Library.Models"
             x:Class="MarkdownLibrary.Views.NotesView"
             x:DataType="vm:NotesViewModel">
    <UserControl.Styles>
        <Style Selector="Button.note-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Spacing="6">
                <TextBlock Text="笔记" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#6B7280"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="刷新"
                    Command="{Binding RefreshCommand}"
                    Padding="16,8"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1"
                IsVisible="{Binding IsEmpty}"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="40">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="460">
                <TextBlock Text="📝" FontSize="40" HorizontalAlignment="Center" />
                <TextBlock Text="还没有笔记"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="打开一本书，在详情页点“写笔记”，摘一段原文或写点想法，这里就会显示。"
                           Foreground="#6B7280"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:NoteListItem">
                        <Button Classes="note-card" Click="OnNoteClick" Margin="0,0,0,10">
                            <Border Background="#FFFFFF"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18,14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="#EFF6FF"
                                                    CornerRadius="4"
                                                    Padding="6,2">
                                                <TextBlock Text="{Binding BookTitle}"
                                                           FontSize="11"
                                                           Foreground="#2563EB" />
                                            </Border>
                                            <TextBlock Text="{Binding UpdatedText}"
                                                       FontSize="11"
                                                       Foreground="#9CA3AF"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Snippet}"
                                                   FontSize="12"
                                                   Foreground="#6B7280"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="›"
                                               FontSize="22"
                                               Foreground="#9CA3AF"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
