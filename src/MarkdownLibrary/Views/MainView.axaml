<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarkdownLibrary.Library.ViewModels"
             x:Class="MarkdownLibrary.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Grid ColumnDefinitions="232,*">
        <Border Background="#111827" Padding="18,24">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="MARKDOWN"
                               Foreground="#93C5FD"
                               FontSize="11"
                               FontWeight="SemiBold"
                               LetterSpacing="3" />
                    <TextBlock Text="图书馆"
                               Foreground="#FFFFFF"
                               FontSize="24"
                               FontWeight="Bold" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,26,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                         SelectionChanged="OnMenuSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MenuItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,4">
                                <TextBlock Text="{Binding Icon}" FontSize="16" />
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           Foreground="#E5E7EB" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Text="本地 Markdown · 离线阅读"
                           Foreground="#6B7280"
                           FontSize="11" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="64,*">
            <Border Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1"
                    Padding="20,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Content="←"
                            Command="{Binding GoBackCommand}"
                            IsVisible="{Binding CanGoBack}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            Padding="8,4"
                            Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Content.PageTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="Markdown Library"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding Content}"
                            Margin="28,22" />
        </Grid>
    </Grid>
</UserControl>
