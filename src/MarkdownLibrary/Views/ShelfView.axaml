<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarkdownLibrary.Library.ViewModels"
             xmlns:models="using:MarkdownLibrary.Library.Models"
             x:Class="MarkdownLibrary.Views.ShelfView"
             x:DataType="vm:ShelfViewModel">
    <UserControl.Styles>
        <Style Selector="Button.card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,18">
            <StackPanel Spacing="6">
                <TextBlock Text="书架" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#6B7280"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="导入文件夹"
                    Command="{Binding ImportFolderCommand}"
                    Margin="8,0"
                    Padding="16,8"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Content="重新扫描"
                    Command="{Binding RefreshCommand}"
                    Padding="16,8"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1"
                IsVisible="{Binding IsEmpty}"
                Background="#FFFFFF"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="40">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14"
                        MaxWidth="460">
                <TextBlock Text="📚" FontSize="42" HorizontalAlignment="Center" />
                <TextBlock Text="书架还是空的"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="选择一个存放 Markdown 文件的文件夹，程序会扫描并把它们加入书库。"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <Button Content="选择书库文件夹"
                        Command="{Binding ImportFolderCommand}"
                        HorizontalAlignment="Center"
                        Padding="18,9"
                        Background="#2563EB"
                        Foreground="White" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Books}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <Button Classes="card" Click="OnBookClick" Margin="0,0,16,16">
                            <Border Width="210"
                                    Height="156"
                                    Background="#FFFFFF"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding SubtitleText}"
                                               Foreground="#6B7280"
                                               FontSize="12"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding StatusText}"
                                               Foreground="#2563EB"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
