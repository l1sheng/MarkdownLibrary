<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarkdownLibrary.Library.ViewModels"
             xmlns:models="using:MarkdownLibrary.Library.Models"
             x:Class="MarkdownLibrary.Views.BookDetailView"
             x:DataType="vm:BookDetailViewModel">
    <UserControl.Styles>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
            <Button Content="← 返回书架"
                    Command="{Binding GoBackCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#2563EB"
                    Padding="0"
                    HorizontalAlignment="Left" />

            <StackPanel Spacing="6">
                <TextBlock Text="{Binding Book.Title}"
                           FontSize="32"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Book.SubtitleText}"
                           Foreground="#6B7280"
                           FontSize="13" />
            </StackPanel>

            <WrapPanel>
                <Border Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,14"
                        Margin="0,0,12,12"
                        MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Text="阅读进度" Foreground="#9CA3AF" FontSize="11" />
                        <TextBlock Text="{Binding ProgressText}" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,14"
                        Margin="0,0,12,12"
                        MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Text="笔记" Foreground="#9CA3AF" FontSize="11" />
                        <TextBlock Text="{Binding NoteCountText}" FontSize="14" />
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18,14"
                        Margin="0,0,12,12"
                        MinWidth="150">
                    <StackPanel Spacing="4">
                        <TextBlock Text="状态" Foreground="#9CA3AF" FontSize="11" />
                        <TextBlock Text="{Binding Book.StatusText}" FontSize="14" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="标签" FontWeight="SemiBold" FontSize="14" />
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Tag">
                                <Border Background="#EFF6FF"
                                        CornerRadius="12"
                                        Padding="10,5"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="#2563EB"
                                                   VerticalAlignment="Center" />
                                        <Button Content="×"
                                                Click="OnRemoveTagClick"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                FontSize="12"
                                                Foreground="#6B7280" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding NewTagName, Mode=TwoWay}"
                                 Watermark="新标签，例如：经典"
                                 Width="220" />
                        <Button Content="添加标签"
                                Command="{Binding AddTagCommand}"
                                Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="内容简介" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding Preview}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               LineHeight="24" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="开始阅读"
                        Command="{Binding StartReadingCommand}"
                        Classes="accent"
                        HorizontalAlignment="Left" />
                <Button Content="写笔记"
                        Command="{Binding AddNoteCommand}"
                        Padding="18,10"
                        CornerRadius="8"
                        Background="#EFF6FF"
                        Foreground="#2563EB" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
